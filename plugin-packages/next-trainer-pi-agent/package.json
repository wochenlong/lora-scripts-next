{
  "name": "@next-trainer/pi-agent-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <22.20.0"
  },
  "scripts": {
    "check:runtime": "node scripts/assert-runtime.mjs",
    "typecheck:sidecar": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "typecheck": "npm run typecheck:sidecar && npm run typecheck:ui",
    "test:unit": "node --experimental-strip-types --test \"sidecar/test/unit/*.test.ts\"",
    "test:contract": "node --experimental-strip-types --test \"sidecar/test/contract/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test \"sidecar/test/integration/*.test.ts\"",
    "test:ui:logic": "node --experimental-strip-types --test \"ui/tests/*.test.mjs\"",
    "test:ui:dom": "vitest run --config ui/vitest.config.ts",
    "test:ui": "npm run test:ui:logic && npm run test:ui:dom",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:ui",
    "sbom": "node scripts/generate-sbom.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "test:isolated": "node scripts/verify-standalone.mjs",
    "check": "npm run check:runtime && npm run typecheck && npm test && npm run build:ui && npm run build:sidecar && npm run test:isolated"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "katex": "0.16.47",
    "proper-lockfile": "4.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "bun": "1.4.0",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
