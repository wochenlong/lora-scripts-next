{
  "schema_version": 1,
  "description": "Rust launcher and mikazuki.networking.policy shared explicit routing contract; credentials are synthetic fixtures.",
  "cases": [
    {
      "id": "auto-no-proxy-alone-keeps-system",
      "saved": {},
      "environ": {
        "NO_PROXY": "example.org"
      },
      "system": {
        "http": "system.test:7891",
        "https": "system.test:7891"
      },
      "expected": {
        "mode": "auto",
        "http_proxy": "http://system.test:7891",
        "https_proxy": "http://system.test:7891",
        "source": "system",
        "no_proxy": "example.org,localhost,127.0.0.1,::1",
        "warning": ""
      },
      "routes": [
        {
          "url": "https://sub.example.org/path",
          "proxy": null,
          "bypass": true
        },
        {
          "url": "https://notexample.org",
          "proxy": "http://system.test:7891",
          "bypass": false
        }
      ]
    },
    {
