+"""One fixed-prompt epoch preview using the upstream sampler in a child process."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+
+def preview_directory(output, epoch):
+    output = Path(output)
+    return output.parent / (output.stem + "_samples") / f"epoch_{epoch:02d}"
+
+
+def render_epoch_preview(req, transformer, network, optimizer, epoch):
+    import torch
+    from library.moss.loader import empty_cache
+
+    prompt_file = Path(req.preview_prompt_file)
+    raw = prompt_file.read_bytes()
+    if hashlib.sha256(raw).hexdigest() != req.preview_caption_sha256:
+        raise ValueError("Preview caption changed since UI submission; refusing a different prompt")
+    if req.blocks_to_swap != 0:
+        raise ValueError("Epoch previews currently require blocks_to_swap=0")
+    out = preview_directory(req.output, epoch)
+    out.mkdir(parents=True, exist_ok=True)
+    job = out / "preview_request.json"
+    payload = {"model_dir": req.model_dir, "model": req.model,
+               "prompt_file": str(prompt_file), "caption_sha256": req.preview_caption_sha256,
+               "cache": req.cache, "lora": str(Path(req.output).with_name(
+                   f"{Path(req.output).stem}_e{epoch}{Path(req.output).suffix}")),
+               "width": req.preview_width, "height": req.preview_height,
+               "steps": req.preview_steps, "seed": req.preview_seed, "out_dir": str(out)}
+    job.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+    # Keep optimizer step scalars on their original device, as well as moment tensors.
+    states = [(state, key, value.device) for state in optimizer.state.values()
+              for key, value in state.items() if torch.is_tensor(value)]
+    transformer.to("cpu")
+    network.to("cpu")
+    for state, key, _device in states:
+        state[key] = state[key].to("cpu")
+    empty_cache()
+    print(f"[moss-preview] epoch {epoch} started -> {out}", flush=True)
+    try:
+        subprocess.run([sys.executable, "-E", "-s", "-u", "-m", "library.moss.preview", str(job)], check=True)
+        images = list(out.glob("*.png"))
+        if len(images) != 1:
+            raise RuntimeError(f"Expected exactly one epoch preview, found {len(images)}")
+        print(f"[moss-preview] epoch {epoch} complete -> {images[0]}", flush=True)
+    finally:
+        transformer.to("cuda")
+        network.to("cuda")
+        for state, key, device in states:
+            state[key] = state[key].to(device)
+        empty_cache()
+
+
+def generate_from_job(job_path):
+    from library.moss.requests import GenerateRequest
+    from library.moss.generate import run_generate
+    from library.moss.loader import MAX_SEQUENCE_LENGTH
+    from safetensors import safe_open
+    from safetensors.torch import load_file, save_file
+
+    data = json.loads(Path(job_path).read_text(encoding="utf-8"))
+    raw = Path(data.pop("prompt_file")).read_bytes()
+    if hashlib.sha256(raw).hexdigest() != data.pop("caption_sha256"):
+        raise ValueError("Fixed preview caption fingerprint mismatch")
+    prompt = raw.decode("utf-8").strip()
+    if not prompt:
+        raise ValueError("Preview caption is empty")
+    cache = Path(data.pop("cache"))
+    out = Path(data["out_dir"])
+    shared = out / "_te_cache"
+    shared.mkdir(exist_ok=True)
+    # Reuse the training prompt/empty TE caches when their identities match.
+    from library.moss.scan import TE_SUFFIX
+    caption_hash = hashlib.sha256(prompt.encode()).hexdigest()
+    for text, source in [(prompt, cache / (Path(json.loads(Path(job_path).read_text())["prompt_file"]).stem + TE_SUFFIX)),
+                         ("", cache / ("_empty" + TE_SUFFIX))]:
+        if not source.is_file():
+            continue
+        with safe_open(source, framework="pt") as f:
+            meta = f.metadata() or {}
+        if text and (meta.get("caption_sha256") != caption_hash or meta.get("max_text_tokens") != str(MAX_SEQUENCE_LENGTH)):
+            continue
+        target = shared / (hashlib.sha1(f"{MAX_SEQUENCE_LENGTH}\0{text}".encode()).hexdigest()[:16] + ".safetensors")
+        if not target.exists():
+            save_file({"embeds": load_file(source)["embeds"].contiguous()}, str(target))
+    return run_generate(GenerateRequest(prompt=prompt, **data))
+
+
+if __name__ == "__main__":
+    generate_from_job(sys.argv[1])
