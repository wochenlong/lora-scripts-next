+"""Shape buckets with retained tails; one batch is one optimizer step."""
+from collections import defaultdict
+
+
+def bucket_batches(samples, shapes, batch_size, rng=None):
+    if isinstance(batch_size, bool) or not isinstance(batch_size, int) or batch_size < 1:
+        raise ValueError("batch_size must be a positive integer")
+    buckets = defaultdict(list)
+    for sample in samples:
+        buckets[tuple(shapes[sample.stem])].append(sample)
+    batches = []
+    for bucket in buckets.values():
+        if rng is not None:
+            rng.shuffle(bucket)
+        batches.extend(bucket[i:i + batch_size] for i in range(0, len(bucket), batch_size))
+    if rng is not None:
+        rng.shuffle(batches)
+    else:
+        batches.sort(key=lambda batch: len(batch) * max(s.n_img + s.n_text for s in batch), reverse=True)
+    return batches
