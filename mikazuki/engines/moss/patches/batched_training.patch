+def import_comfy_state(state, target_names, alpha):
+    if not any(key.startswith("diffusion_model.") for key in state):
+        return state
+    result = {}
+    for name in target_names:
+        source = "diffusion_model." + name
+        target = "adapters." + name.replace(".", "_")
+        if float(state[source + ".alpha"]) != float(alpha):
+            raise ValueError("MOSS adapter alpha differs from its metadata")
+        result[target + ".down.weight"] = state[source + ".lora_down.weight"]
+        result[target + ".up.weight"] = state[source + ".lora_up.weight"]
+    if len(state) != 3 * len(target_names):
+        raise ValueError("Unexpected tensors in ComfyUI MOSS adapter state")
+    return result
 
 
